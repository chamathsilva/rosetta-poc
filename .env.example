# Copy to .env for local work. On the droplet these are supplied by the
# systemd EnvironmentFile - see docs/PATTERNS/env-config-secrets.md.
# Placeholders only. Never commit a real secret.

# PostgreSQL connection string. Self-hosted on the same host in production.
# Matches compose.yml's local dev credentials (rosetta/rosetta) so `docker
# compose up -d` + `cp .env.example .env` works with no edits. On the
# droplet this is real credentials, never these.
DATABASE_URL=postgres://rosetta:rosetta@localhost:5432/rosetta_poc

# Dedicated database for tests and the destructive reset. Distinct from
# DATABASE_URL and never falls back to it. The database name MUST end
# `_test` - the reset refuses to run against any target that does not, since
# DATABASE_URL may point at data someone cares about. See
# plans/walking-skeleton/WALKING-SKELETON-PLAN.md "Test database and reset
# safety".
TEST_DATABASE_URL=postgres://rosetta:rosetta@localhost:5432/rosetta_poc_test

# Signing key for session JWTs. Generate with: openssl rand -base64 48
# Rotating it invalidates every live session - there is no refresh-token flow.
JWT_SECRET=replace-with-a-long-random-value

# Port the Node process listens on. Caddy proxies to it.
PORT=3000

# Origin allowlisted for the /ws upgrade (RFC 6455 SS4.2 puts this check on
# the server; sameSite is defence-in-depth, not a substitute). In production
# this is the deployed subdomain. For local work with `npm run dev:client`,
# this MUST be Vite's dev-server origin (e.g. http://localhost:5173), not
# localhost:3000 - see agents/TEMP/walking-skeleton/architecture-notes.md,
# "Local development" (getting this wrong presents as a 403 on upgrade with
# an otherwise working page).
ALLOWED_ORIGIN=http://localhost:5173

# Conventional, not fail-fast checked.
NODE_ENV=development

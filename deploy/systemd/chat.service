# chat.service — the application unit.
#
# Design: plans/gated-deploy/architecture-notes.md §5.1. Installed once by
# the runbook to /etc/systemd/system/chat.service, then `daemon-reload` +
# `enable`. Cannot be validated on this darwin dev box — `systemd-analyze
# verify` is a Linux-only tool; runbook step 10 is the real check
# (AC-SYS-8).
#
# WorkingDirectory/ExecStart resolve through /srv/chat/current, the release
# symlink — this file names NO release path. The symlink, flipped
# atomically by the deploy workflow, is the entire rollback contract
# (arch-notes §8): rolling back is "point the symlink elsewhere and
# restart", never "edit this unit".

[Unit]
Description=Rosetta POC chat
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=rosetta-chat
Group=rosetta-chat
WorkingDirectory=/srv/chat/current

# Two files, both required (no "-" prefix): a missing file must be a loud
# unit failure, not a start that limps to a later loadConfig() throw
# (src/server/config.ts). Split deliberately (arch-notes §4.7, §6.1):
#   - secrets.env  (host-scoped, root:rosetta-chat 0640) — DATABASE_URL,
#     JWT_SECRET. Never touched by CI, never readable by the `deploy` user.
#   - deploy.env   (release-scoped, generated by the deploy workflow) —
#     ALLOWED_ORIGIN, PORT, NODE_ENV. Flips with the symlink, so a rollback
#     restores the matching non-secret config too.
EnvironmentFile=/etc/rosetta-chat/secrets.env
EnvironmentFile=/srv/chat/current/deploy.env

# V8 heap ceiling paired with MemoryMax below (AC-SYS-5) so an OOM produces
# a diagnosable heap error from V8 instead of a silent kernel OOM-kill.
# Neither number is measured against real load (docs/ASSUMPTIONS.md
# capacity ceiling) — both are safe-failure bounds, first to revisit once
# real numbers exist.
Environment=NODE_OPTIONS=--max-old-space-size=384

# node invoked DIRECTLY — never `npm start`. npm would leave a supervising
# process alive for the life of the service (tens of MB of the shared
# gigabyte) plus a signal-forwarding layer, for no benefit (arch-notes
# §5.1).
ExecStart=/usr/bin/node dist/server/index.js

# Type=exec (not `simple`): systemctl start reports failure if the binary
# itself cannot be invoked; `simple` would report success even then. The
# deploy script's exit code is only as honest as this setting.
Restart=on-failure
RestartSec=5

# --- Hardening kept deliberately narrow (arch-notes §5.3) ---
# Namespace/prctl hardening below costs a handful of mount operations once
# at start and ZERO steady-state memory — it does not compete with
# Postgres for the gigabyte, so it is worth having regardless of memory
# pressure. Two things are DELIBERATELY NOT set, and must stay that way:
#
#   - MemoryDenyWriteExecute IS NOT SET. Setting it BREAKS V8's JIT — this
#     is the most common way a "hardened" Node unit fails to start, and it
#     fails looking like a Node bug. Do not add it.
#   - SystemCallFilter IS NOT SET (deferred). Marginal gain over
#     NoNewPrivileges + ProtectSystem=strict is small, and a wrong filter
#     surfaces at runtime as behaviour indistinguishable from an
#     application bug. It cannot be validated from this repo — only
#     against the real droplet. Revisit after the host exists.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# The application writes no files today — logs go to stdout, thence
# journald. ProtectSystem=strict mounts the tree read-only except
# /dev,/proc,/sys; PrivateTmp supplies a writable /tmp. No
# ReadWritePaths= is declared. IF THE APPLICATION EVER WRITES A FILE, THIS
# UNIT MUST CHANGE IN THE SAME COMMIT, or it fails at runtime with a
# confusing EROFS.

MemoryMax=512M
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target

{
  "name": "rosetta-poc-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Guest-and-registered web chat. Vehicle for an evaluation of the Rosetta instruction layer.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json && find dist -name '*.test.js' -o -name '*.test.js.map' | xargs rm -f",
    "build:client": "NODE_ENV=production vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "start": "node dist/server/index.js",
    "watch:server": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev:client": "vite",
    "migrate": "node-pg-migrate up -m src/db/migrations",
    "db:reset:test": "tsx src/db/reset-test-db.ts && node-pg-migrate up -m src/db/migrations -d TEST_DATABASE_URL",
    "lint": "eslint .",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.16.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
